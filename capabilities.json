{
    "dataRoles": [
        {
            "name": "dayAxis",
            "kind": "Grouping",
            "displayName": "Dzień / kategoria (wiersz)",
            "displayNameKey": "Role_DayAxis",
            "description": "Kategoria na osi wierszy, np. dzień tygodnia lub data"
        },
        {
            "name": "hourAxis",
            "kind": "Grouping",
            "displayName": "Godzina / kategoria (kolumna)",
            "displayNameKey": "Role_HourAxis",
            "description": "Kategoria na osi kolumn, np. godzina 0-23"
        },
        {
            "name": "intensity",
            "kind": "Measure",
            "displayName": "Wolumen / intensywność",
            "displayNameKey": "Role_Intensity",
            "description": "Wartość intensywności komórki: liczba rekordów, zdarzeń, logowań, błędów itp.",
            "requiredTypes": [
                { "numeric": true }
            ]
        },
        {
            "name": "tooltipData",
            "kind": "Measure",
            "displayName": "Dodatkowe dane w tooltipie",
            "displayNameKey": "Role_Tooltip",
            "description": "Opcjonalne dodatkowe metryki wyświetlane w tooltipie"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "dayAxis": { "max": 1 },
                    "hourAxis": { "max": 1 },
                    "intensity": { "max": 1 },
                    "tooltipData": { "max": 5 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": { "in": "dayAxis" },
                    "dataReductionAlgorithm": { "top": { "count": 60 } }
                },
                "values": {
                    "group": {
                        "by": "hourAxis",
                        "select": [
                            { "bind": { "to": "intensity" } },
                            { "bind": { "to": "tooltipData" } }
                        ],
                        "dataReductionAlgorithm": { "top": { "count": 60 } }
                    }
                }
            }
        }
    ],
    "objects": {
        "dataColors": {
            "properties": {
                "colorScale": { "type": { "enumeration": [] } },
                "minColor": { "type": { "fill": { "solid": { "color": true } } } },
                "maxColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "cellLayout": {
            "properties": {
                "cellGap": { "type": { "numeric": true } },
                "cellRadius": { "type": { "numeric": true } },
                "showAxisLabels": { "type": { "bool": true } }
            }
        },
        "anomalyDetection": {
            "properties": {
                "show": { "type": { "bool": true } },
                "thresholdStdDev": { "type": { "numeric": true } },
                "highlightColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "dataLabels": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontSize": { "type": { "numeric": true } },
                "decimalPlaces": { "type": { "numeric": true } }
            }
        },
        "legend": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontSize": { "type": { "numeric": true } }
            }
        }
    },
    "privileges": [],
    "supportsHighlight": true,
    "sorting": {
        "default": {}
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": ["dayAxis", "hourAxis", "intensity", "tooltipData"]
    }
}
